# .env.example
# For local development, you can copy this to a .env file and fill in your actual values.
# Ensure .env is in your .gitignore file and never commit your actual .env file.

# Used by aiden_ai_backend/security.py
AUTH_SECRET_KEY="your_super_strong_random_secret_key_here_for_jwt"
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=48
AUTH_PASSWORD_RESET_TOKEN_EXPIRE_HOURS=2

# Used by aiden_ai_backend/email_ingestion_service.py
# Replace with your actual test Gmail account and App Password if using Gmail for testing ingestion
# IMAP_HOST="imap.gmail.com"
# IMAP_USER="your_test_email@gmail.com"
# IMAP_PASS="your_gmail_app_password"

# Used by aiden_ai_backend/two_factor_auth.py
# APP_NAME="YourAppName" # Optional: if you want to customize the issuer name in TOTP authenticator apps
